  "datasets": {
    "security_master": {
      "dataset_id": "security_master",
      "schema_version": "1.0.0",
      "semantic_role": "point-in-time security identity and market membership",
      "primary_sources": [
        {"source_id": "twse_security_master", "coverage": ["listed"]},
        {"source_id": "tpex_security_master", "coverage": ["otc"]}
      ],
      "fallback_sources": [{"source_id": "finmind_normalized_fallback", "coverage": ["listed", "otc"]}],
      "freshness": {"mode": "trading_day", "frequency": "daily snapshot", "max_lag_trading_days": 1, "expected_available_by": "20:00 Asia/Taipei"},
      "canonical_fields": [
        {"name": "data_date", "type": "date", "required": true},
        {"name": "security_id", "type": "string", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "market", "type": "enum:listed|otc|emerging", "required": true},
        {"name": "security_type", "type": "string", "required": true},
        {"name": "listing_date", "type": "date|null", "required": false},
        {"name": "delisting_date", "type": "date|null", "required": false},
        {"name": "industry_code", "type": "string|null", "required": false},
        {"name": "issued_shares", "type": "integer|null", "required": false}
      ]
    },
    "trading_calendar": {
      "dataset_id": "trading_calendar",
      "schema_version": "1.0.0",
      "semantic_role": "official market sessions; required to calculate trading-day freshness",
