{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tcfsh010778.github.io/stock-from-Hsiu/schemas/technical_pattern_packet.schema.json",
  "title": "Stock from Hsiu technical pattern packet",
  "type": "object",
  "required": [
    "schema_version",
    "engine_version",
    "stock_id",
    "timeframe",
    "data_date",
    "price_adjustment",
    "series",
    "patterns",
    "trendlines",
    "support_resistance",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "engine_version": {"type": "string", "minLength": 1},
    "stock_id": {"type": "string", "pattern": "^[0-9A-Za-z.-]+$"},
    "timeframe": {"enum": ["daily", "weekly", "monthly"]},
    "data_date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string"},
    "price_adjustment": {
      "type": "object",
      "required": ["mode", "verified"],
      "properties": {
        "mode": {"type": "string"},
        "source": {"type": ["string", "null"]},
        "verified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["action_state"],
      "properties": {"action_state": {"type": "string"}},
      "additionalProperties": true
    },
    "freshness": {"type": "object"},
    "technical_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/technical_evidence_item"}
    },
    "risk_control": {
      "type": "object",
      "required": ["method", "reference_date", "reference_price", "stop_loss_pct", "stop_price"],
      "properties": {
        "method": {"const": "fixed_percent_from_latest_close"},
        "reference_date": {"type": "string", "format": "date"},
        "reference_price": {"type": "number"},
        "stop_loss_pct": {"const": 15.0},
        "stop_price": {"type": "number"}
      },
      "additionalProperties": false
    },
    "market_evidence": {
      "type": "object",
      "required": ["institutional", "foreign_ownership", "margin", "holdings", "source_dates", "gaps"],
      "properties": {
        "institutional": {"type": "array", "items": {"type": "object"}},
        "foreign_ownership": {"type": "array", "items": {"type": "object"}},
        "margin": {"type": "array", "items": {"type": "object"}},
        "holdings": {"type": "array", "items": {"type": "object"}},
        "source_dates": {"type": "object", "additionalProperties": {"type": "string", "format": "date"}},
        "gaps": {"type": "array", "items": {"enum": ["institutional", "foreign_ownership", "margin", "holdings"]}}
      },
      "additionalProperties": false
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "open", "high", "low", "close", "volume"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "open": {"type": "number"},
          "high": {"type": "number"},
          "low": {"type": "number"},
          "close": {"type": "number"},
          "volume": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "swings": {"type": "array", "items": {"type": "object"}},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern_id",
          "name",
          "category",
          "direction",
          "status",
          "start_date",
          "end_date",
          "evidence",
          "missing_conditions",
          "counterevidence",
          "detector",
          "parameters_version",
          "quality_score"
        ],
        "properties": {
          "pattern_id": {"type": "string"},
          "name": {"type": "string"},
          "category": {"enum": ["candlestick", "price_structure"]},
          "direction": {"enum": ["bullish", "bearish", "neutral"]},
          "status": {"enum": ["forming", "confirmed", "invalidated"]},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "confirmed_at": {"type": ["string", "null"]},
          "invalidation_price": {"type": ["number", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "missing_conditions": {"type": "array", "items": {"type": "string"}},
          "counterevidence": {"type": "array", "items": {"type": "string"}},
          "detector": {"enum": ["ta-lib", "custom"]},
          "parameters_version": {"type": "string"},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 100}
        },
        "additionalProperties": false
      }
    },
    "trendlines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "kind",
          "timeframe",
          "status",
          "start",
          "end",
          "anchors",
          "touch_count",
          "violation_count",
          "slope_per_bar",
          "quality_score",
          "breakout"
        ],
        "properties": {
          "line_id": {"type": "string"},
          "kind": {"enum": ["support", "resistance", "channel"]},
          "timeframe": {"enum": ["daily", "weekly", "monthly"]},
          "status": {"enum": ["forming", "confirmed", "invalidated"]},
          "start": {"$ref": "#/$defs/point"},
          "end": {"$ref": "#/$defs/point"},
          "anchors": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 2},
          "touch_count": {"type": "integer", "minimum": 2},
          "violation_count": {"type": "integer", "minimum": 0},
          "slope_per_bar": {"type": "number"},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
          "breakout": {"type": "object"},
          "channel": {"type": "object"},
          "parameters_version": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "support_resistance": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["date", "price"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "price": {"type": "number"}
      },
      "additionalProperties": false
    },
    "technical_evidence_item": {
      "type": "object",
      "required": [
        "schema_version", "dataset_id", "security_id", "market", "data_date", "timeframe",
        "indicator_id", "name", "definition_version", "parameters", "unit", "comparison_basis",
        "missing_value_policy", "extreme_value_policy", "value", "value_status", "calculation_basis",
        "confirmed_at", "source_id", "upstream_dataset_id", "fetched_at", "frequency", "timezone",
        "adjustment_policy", "test_status", "evidence_role", "freshness", "known_gaps"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "dataset_id": {"const": "technical_indicator_evidence"},
        "security_id": {"type": "string", "pattern": "^[0-9A-Za-z.-]+$"},
        "market": {"enum": ["listed", "otc", "emerging"]},
        "data_date": {"type": "string", "format": "date"},
        "timeframe": {"const": "daily"},
        "indicator_id": {"enum": ["rsi_14", "macd_12_26_9", "bollinger_20_2", "volume_vs_avg_3", "volume_vs_avg_5", "volume_vs_avg_10"]},
        "name": {"type": "string", "minLength": 1},
        "definition_version": {"type": "string", "minLength": 1},
        "parameters": {"type": "object", "minProperties": 1},
        "unit": {"type": "string", "minLength": 1},
        "comparison_basis": {"type": "string", "minLength": 1},
        "missing_value_policy": {"type": "string", "minLength": 1},
        "extreme_value_policy": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "value_status": {"enum": ["available", "insufficient_history", "missing", "non_finite"]},
        "calculation_basis": {"const": "closed_bar_only"},
        "confirmed_at": {"type": ["string", "null"], "format": "date"},
        "source_id": {"const": "technical_indicator_evidence_derived"},
        "upstream_dataset_id": {"const": "daily_price"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "frequency": {"const": "daily_after_close"},
        "timezone": {"const": "Asia/Taipei"},
        "adjustment_policy": {"type": "string", "minLength": 1},
        "comparison_values": {"type": "object"},
        "test_status": {"enum": ["unit_tested", "golden_file", "unverified"]},
        "evidence_role": {"const": "auxiliary_evidence_only"},
        "freshness": {"$ref": "#/$defs/technical_freshness"},
        "known_gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"value_status": {"const": "available"}}}, "then": {"properties": {"value": {"type": "number"}}}},
        {"if": {"properties": {"value_status": {"enum": ["insufficient_history", "missing", "non_finite"]}}}, "then": {"properties": {"value": {"type": "null"}}}}
      ],
      "additionalProperties": false
    },
    "technical_freshness": {
      "type": "object",
      "required": ["status", "as_of", "sla"],
      "properties": {
        "status": {"enum": ["fresh", "expected_lag", "stale", "missing", "fallback_fresh", "fallback_stale", "schema_error"]},
        "as_of": {"type": ["string", "null"], "format": "date"},
        "sla": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
